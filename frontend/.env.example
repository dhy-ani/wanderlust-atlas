# Frontend environment (Vite exposes only VITE_* vars to the browser).
# Copy to `.env`.

# Google Maps JavaScript API key — powers the 2D detail map's Satellite view
# and Street View. Enable "Maps JavaScript API" in Google Cloud Console.
# Leave blank to fall back to keyless Leaflet + Esri satellite tiles
# (Street View is unavailable without this key).
VITE_GOOGLE_MAPS_API_KEY=

# Base URL of the backend API. Empty = use the Vite dev proxy (recommended in dev).
VITE_API_BASE=
