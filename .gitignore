# --- secrets ---
.env
*.env
!.env.example

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
backend/mutants/

# --- Vercel build artifact: vercel.json's buildCommand copies backend/app +
# backend/data here at deploy time so the Python function bundler (which only
# reliably packages files inside api/) picks them up. Never commit the copy. ---
api/app/
api/data/

# --- user-added custom destinations (runtime state) ---
backend/data/custom_destinations.json

# --- agent system runtime state (groups, identities, memory, LLM cache) ---
backend/data/groups.json
backend/data/identities.json
backend/data/end_surveys.json
backend/data/memory_fallback.json
backend/data/llm_cache.sqlite3
backend/data/chroma/
backend/data/app.db
backend/data/test_app.db

# --- Vercel ---
.vercel/

# --- node / vite ---
node_modules/
frontend/dist/
frontend/.vite/

# --- editors / os ---
.vscode/
.idea/
.DS_Store
Thumbs.db
.vercel
