# ============================================================================
#  Wanderlust Atlas — environment variables
#  Copy this file to `.env` (repo root) and fill in the keys you have.
#  Flights / best-time / budget-vs-luxury have NO mock fallback: without
#  TAVILY_API_KEY + OPENROUTER_API_KEY (below) they honestly report
#  "not configured" instead of fabricating numbers.
# ============================================================================

# ---- Places search: Google Places (server-side key) ------------------------
# Google Cloud Console -> APIs & Services -> Places API. Restrict to your IP.
# Without this, falls back to real (keyless) OpenStreetMap Nominatim search.
GOOGLE_PLACES_API_KEY=

# ---- Backend behaviour -----------------------------------------------------
# CORS origin of the frontend dev server
FRONTEND_ORIGIN=http://localhost:5173

# ---- Docker (docker compose reads this file automatically) -----------------
# Browser key baked into the frontend image at build time (Google Satellite +
# Street View). Same value as frontend/.env's VITE_GOOGLE_MAPS_API_KEY.
VITE_GOOGLE_MAPS_API_KEY=
# Host port to publish the app on -> http://localhost:HOST_PORT
HOST_PORT=8080

# ============================================================================
#  Multi-agent group planner (agent-integration branch only)
#  Fully functional with ALL of these blank (rule-based scoring, static
#  GraphRAG, keyword memory). See docs/architecture-v2/SYSTEM_ARCHITECTURE.md.
# ============================================================================

# ---- LLM: OpenRouter (used to tie-break AMBIGUOUS scores + write chat-log
# prose; most proposals never reach this — see the cost-control design doc) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cheapest-effective default. Override per-role if you want a stronger mediator
# while keeping high-volume twin scoring cheap.
TWIN_MODEL=google/gemini-2.5-flash-lite
MEDIATOR_MODEL=google/gemini-2.5-flash-lite

# ---- Neo4j (GraphRAG) -------------------------------------------------------
# Only used when running with docker-compose.agents.yml. Password must match
# what you set here (compose passes it to both neo4j and the backend).
NEO4J_PASSWORD=wanderlust123

# ---- Web research: LangChain + Tavily ---------------------------------------
# https://tavily.com  ->  free tier API key. Reuses OPENROUTER_API_KEY above.
# Powers BOTH the solo flights/best-time/trade-off endpoints (live_data_agent.py)
# and the group Research Agent. Without this, those endpoints report a clear
# "not configured" status instead of crashing or faking data.
TAVILY_API_KEY=

# ============================================================================
#  Accounts + persistent storage (real sign-in — see app/db/)
# ============================================================================

# Set a real random secret before deploying anywhere public — sessions are
# forged-able by anyone who knows this value. Generate one with, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRES_HOURS=168

# Leave blank for local/Docker use (falls back to a SQLite file at
# backend/data/app.db). On Vercel, set this to your Vercel Postgres / Neon
# connection string — serverless functions have no persistent local disk.
DATABASE_URL=
