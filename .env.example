# ============================================================================
#  Wanderlust Atlas — environment variables
#  Copy this file to `.env` (repo root) and fill in the keys you have.
#  EVERY feature has a mock fallback, so the app runs even with blanks.
#  See docs/SETUP.md for step-by-step instructions to obtain each key.
# ============================================================================

# ---- Flights: Amadeus Self-Service (free sandbox) --------------------------
# https://developers.amadeus.com  ->  create app  ->  copy API Key + Secret
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" (free sandbox data) or "production" (paid, real prices)
AMADEUS_ENV=test

# ---- Weather: OpenWeather (free tier) --------------------------------------
# https://openweathermap.org/api  ->  API keys
OPENWEATHER_API_KEY=

# ---- Places search: Google Places (server-side key) ------------------------
# Google Cloud Console -> APIs & Services -> Places API. Restrict to your IP.
GOOGLE_PLACES_API_KEY=

# ---- Backend behaviour -----------------------------------------------------
# Force mock data even when keys are present (useful for offline dev):  true / false
USE_MOCK_DATA=false
# CORS origin of the frontend dev server
FRONTEND_ORIGIN=http://localhost:5173
